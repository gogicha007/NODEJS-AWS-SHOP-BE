Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0

packages:
  yum:
    certbot: []

container_commands:
  01_validate_letsencrypt_env:
    command: |
      set -euo pipefail
      if [ ! -f /opt/elasticbeanstalk/deployment/env ]; then
        echo "Missing /opt/elasticbeanstalk/deployment/env"
        exit 1
      fi

      set -a
      . /opt/elasticbeanstalk/deployment/env
      set +a

      if [ -z "${DOMAIN_NAME:-}" ]; then
        echo "DOMAIN_NAME environment property is required"
        exit 1
      fi

      if [ -z "${CERTBOT_EMAIL:-}" ]; then
        echo "CERTBOT_EMAIL environment property is required"
        exit 1
      fi

  02_issue_certificate_once:
    command: |
      set -euo pipefail
      set -a
      . /opt/elasticbeanstalk/deployment/env
      set +a

      CERT_PATH="/etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem"

      if [ -f "$CERT_PATH" ]; then
        echo "Certificate already exists for ${DOMAIN_NAME}, skipping initial issuance"
        exit 0
      fi

      systemctl stop nginx
      certbot certonly --standalone --non-interactive --agree-tos \
        --email "${CERTBOT_EMAIL}" \
        -d "${DOMAIN_NAME}"
      systemctl start nginx

  03_setup_renewal_cron:
    command: |
      set -euo pipefail
      cat > /etc/cron.d/certbot-renew <<'EOF'
      17 3 * * * root systemctl stop nginx && certbot renew --quiet --non-interactive; RC=$?; systemctl start nginx; if [ $RC -eq 0 ]; then systemctl reload nginx; fi
      EOF
      chmod 644 /etc/cron.d/certbot-renew
